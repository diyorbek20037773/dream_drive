# DreamDrive configuration contract (names: docs/IMPLEMENTATION_SPEC.md section 3.1).
# Local: `make init-env` copies this file to .env (git-ignored) and generates APP_SECRET and
# GRAFANA_ADMIN_PASSWORD without printing them. Never commit a filled .env.
# Production: a separate chmod-600 env file on the server (docs/DEPLOY.md); image digests come from release.env.
APP_ENV=development
DEFAULT_LOCALE=uz
GIT_REPOSITORY=https://github.com/diyorbek20037773/dream_drive
DOCKERHUB_NAMESPACE=diyorbek7377
PUBLIC_ORIGIN=http://localhost:8080
# Secrets: generated locally by scripts/init-env.sh (APP_SECRET) or chosen by the operator (ADMIN_PASSWORD;
# blank = operator login disabled).
APP_SECRET=
ADMIN_PASSWORD=

# Limits (engineering limits, not measured capacity)
MAX_UPLOAD_BYTES=104857600
MAX_VIDEO_SECONDS=120
MAX_VIDEO_WIDTH=1920
MAX_VIDEO_HEIGHT=1080
MAX_QUEUED_PER_SESSION=2
MAX_QUEUED_TOTAL=10
MAX_REQUESTS_PER_MINUTE=10
MAX_SIMULATION_WALL_SECONDS=120
ARTIFACT_RETENTION_HOURS=24
ANALYSIS_FPS=5

# Inference (internal service; CPU default)
INFERENCE_DEVICE=cpu
INFERENCE_PRECISION=fp32
INFERENCE_CPUS=4
INFERENCE_MAX_WAITERS=4
INFERENCE_MAX_IMAGE_BYTES=8388608
INFERENCE_CONF_THRESHOLD=0.1
INFERENCE_BASE_URL=http://inference:8001
MODEL_MANIFEST_PATH=/app/config/models.resolved.yaml
MODEL_ROOT=/models
INFERENCE_TIMEOUT_SECONDS=30
SIM_INFERENCE_TIMEOUT_SECONDS=5

# Simulation
SIMULATOR=lite
SIM_PERCEPTION_SOURCE=synthetic_rgb_cv
SIM_FIXED_DT_SECONDS=0.05
LEARNED_SIM_MODE_ENABLED=false
CARLA_HOST=

# Storage/queue (fixed to the compose volumes/services; listed for reference)
REDIS_URL=redis://redis:6379/0
SQLITE_PATH=/data/dreamdrive.db
DATA_ROOT=/data
ARTIFACT_ROOT=/data/artifacts
LOG_LEVEL=INFO

# MLOps / monitoring (compose.ops.yaml; UIs bind to 127.0.0.1 only)
ENABLE_MLFLOW=false
MLFLOW_TRACKING_URI=http://mlflow:5000
GRAFANA_ADMIN_PASSWORD=

# Local compose knobs
DD_TAG=dev
DD_HTTP_PORT=8080
DD_PROMETHEUS_PORT=9090
DD_GRAFANA_PORT=3000
DD_MLFLOW_PORT=5000

# Production-only values provided later; digests must be real, verified values (deploy.sh refuses blanks and
# placeholders). DEPLOY_* describe how an operator reaches the server; they are not read by containers.
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_SSH_KEY_PATH=
DOMAIN=
WEB_IMAGE_DIGEST=
BACKEND_IMAGE_DIGEST=
INFERENCE_IMAGE_DIGEST=
GATEWAY_IMAGE=
REDIS_IMAGE=
