# DreamDrive local gateway (compose.yaml). Plain HTTP on :8080 inside the container; Compose publishes it on
# 127.0.0.1:${DD_HTTP_PORT:-8080} only. Production uses Caddyfile.prod (automatic HTTPS).
{
	admin off
	auto_https off
	persist_config off
}

import /etc/caddy/routes.caddy

:8080 {
	import dreamdrive_security_headers
	import dreamdrive_access_log
	import dreamdrive_routes
}
