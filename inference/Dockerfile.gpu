# syntax=docker/dockerfile:1.7
# DreamDrive inference service, optional CUDA variant (linux/amd64, NVIDIA driver with CUDA >= 12.6 on the host).
# Same application code as inference/Dockerfile; torch/torchvision come from the PyTorch cu126 wheels
# (inference/gpu/uv.lock), which bundle the CUDA runtime libraries. The host supplies the driver via the NVIDIA
# container runtime (`docker run --gpus all`). Build context = repository root:
#   docker build -f inference/Dockerfile.gpu --target runtime -t dreamdrive-inference-gpu:dev .
#   docker build -f inference/Dockerfile.gpu --target test    -t dreamdrive-inference-gpu:test .

ARG PYTHON_IMAGE=python:3.11-slim-bookworm

FROM ${PYTHON_IMAGE} AS base
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/app --shell /usr/sbin/nologin app \
    && mkdir -p /models /app/inference /app/config \
    && chown 10001:10001 /models

FROM base AS builder
COPY --from=ghcr.io/astral-sh/uv:0.12.9 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=/usr/local/bin/python3.11 \
    UV_PROJECT_ENVIRONMENT=/app/inference/.venv
WORKDIR /app/inference
COPY inference/gpu/pyproject.toml inference/gpu/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

FROM builder AS builder-dev
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project

FROM base AS runtime
ARG GIT_COMMIT=unknown
ARG BUILD_VERSION=dev
LABEL org.opencontainers.image.title="dreamdrive-inference-gpu" \
      org.opencontainers.image.description="DreamDrive internal inference service: YOLOPv2 + RF-DETR Nano (CUDA 12.6 wheels, linux/amd64)" \
      org.opencontainers.image.source="https://github.com/diyorbek20037773/dream_drive" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.opencontainers.image.licenses="MIT"
WORKDIR /app/inference
COPY --from=builder /app/inference/.venv /app/inference/.venv
COPY config/models.resolved.yaml /app/config/models.resolved.yaml
COPY inference/gpu/pyproject.toml /app/inference/pyproject.toml
COPY inference/app /app/inference/app
ENV PATH="/app/inference/.venv/bin:${PATH}" \
    PYTHONPATH=/app/inference \
    MODEL_ROOT=/models \
    MODEL_MANIFEST_PATH=/app/config/models.resolved.yaml \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    MPLCONFIGDIR=/tmp/matplotlib \
    INFERENCE_DEVICE=cuda \
    INFERENCE_PRECISION=fp16 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    GIT_COMMIT=${GIT_COMMIT} \
    BUILD_VERSION=${BUILD_VERSION}
USER 10001:10001
EXPOSE 8001
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]

FROM runtime AS test
USER root
COPY --from=builder-dev /app/inference/.venv /app/inference/.venv
COPY tests/unit/inference /app/tests/unit/inference
COPY tests/model_smoke /app/tests/model_smoke
COPY tests/fixtures/images /app/tests/fixtures/images
USER 10001:10001
ENV PYTEST_ADDOPTS="-p no:cacheprovider"
CMD ["pytest", "/app/tests/unit/inference", "-q"]
