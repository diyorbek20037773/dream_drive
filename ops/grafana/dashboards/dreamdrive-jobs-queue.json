{
  "uid": "dreamdrive-jobs-queue",
  "title": "DreamDrive / Jobs and queue",
  "description": "RQ queue depth/age, job outcomes, processed frames and per-stage video pipeline timing.",
  "tags": [
    "dreamdrive"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "Queue depth",
      "description": "Jobs waiting per RQ queue (video, sim, eval).",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "max by (queue) (dreamdrive_queue_depth)",
          "legendFormat": "{{queue}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Oldest queued job age",
      "description": "Age of the oldest waiting job from real enqueue timestamps. SLA alert at 900 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "max by (queue) (dreamdrive_queue_oldest_age_seconds)",
          "legendFormat": "{{queue}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Finished jobs per hour by status",
      "description": "Terminal job outcomes (succeeded, failed, cancelled, interrupted) per kind.",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "sum by (kind, status) (increase(dreamdrive_jobs_total[1h]))",
          "legendFormat": "{{kind}} {{status}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Frames processed per second",
      "description": "Actual analyzed frames per mode, perception source and outcome (from counts).",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "sum by (mode, source, outcome) (rate(dreamdrive_frames_processed_total[5m]))",
          "legendFormat": "{{mode}} {{source}} {{outcome}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Video pipeline stage p95",
      "description": "End-to-end stage timing (probe, decode, inference, annotate, encode, report) per job.",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(dreamdrive_video_stage_duration_seconds_bucket[15m])))",
          "legendFormat": "{{stage}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Video pipeline stage time share",
      "description": "Seconds per second spent in each stage across all jobs (where wall time goes).",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "sum by (stage) (rate(dreamdrive_video_stage_duration_seconds_sum[15m]))",
          "legendFormat": "{{stage}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    }
  ]
}
