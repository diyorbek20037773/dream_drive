    {
      "type": "stat",
      "title": "Model ready",
      "description": "1 only after the SHA256-verified checkpoint loaded and passed warm-up.",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "max by (model, device) (dreamdrive_model_ready)",
          "legendFormat": "{{model}} {{device}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Model cold start",
      "description": "Measured verify + load + warm-up seconds of the last successful start.",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "max by (model, device) (dreamdrive_model_load_seconds)",
          "legendFormat": "{{model}} {{device}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Worker heartbeat age",
      "description": "Seconds since each worker slot last reported progress. Alert threshold 120 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "dreamdrive_worker_heartbeat_age_seconds",
          "legendFormat": "{{slot}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP requests by status class",
      "description": "API request rate by status class (route templates only, no ids).",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "sum by (status_class) (rate(dreamdrive_http_requests_total[5m]))",
          "legendFormat": "{{status_class}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency by route",
      "description": "95th percentile API handler latency per route template.",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(dreamdrive_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Firing alerts",
      "description": "Alerts currently firing in Prometheus. No notification destination is configured.",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Data volume free space",
      "description": "Free bytes on the /data volume (SQLite, uploads, artifacts). Alert below 5 GB.",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5000000000.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "dreamdrive_data_volume_free_bytes",
          "legendFormat": "free",
          "range": true,
          "instant": false
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Artifact bytes by category",
      "description": "Stored artifact bytes per category, after retention cleanup.",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "sum by (category) (dreamdrive_artifact_bytes)",
          "legendFormat": "{{category}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 11,
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      }
    }
  ]
}
