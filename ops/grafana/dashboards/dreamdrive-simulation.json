{
  "uid": "dreamdrive-simulation",
  "title": "DreamDrive / Simulation",
  "description": "LiteRoad closed-loop health: real-time factor, safety overrides and camera frame age.",
  "tags": [
    "dreamdrive"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "Simulation real-time factor",
      "description": "Simulated seconds per wall second (paced to <= 1.0; lower means the loop is slower than real time).",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "dreamdrive_simulation_realtime_factor",
          "legendFormat": "{{simulator}} {{source}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Safety overrides",
      "description": "Safety supervisor overrides per reason code and perception source (5 min).",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "sum by (reason, perception_source) (increase(dreamdrive_safety_overrides_total[5m]))",
          "legendFormat": "{{reason}} {{perception_source}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Frame acquisition age",
      "description": "Age of the camera frame consumed by perception; stale frames force a safety state.",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "dreamdrive_frame_acquisition_age_seconds",
          "legendFormat": "{{source}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Simulation frames per second",
      "description": "Closed-loop perception frames processed per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "dd-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dd-prometheus"
          },
          "expr": "sum by (source, outcome) (rate(dreamdrive_frames_processed_total{mode=\"simulation\"}[5m]))",
          "legendFormat": "{{source}} {{outcome}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    }
  ]
}
